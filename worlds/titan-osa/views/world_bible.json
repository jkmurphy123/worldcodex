    "materials": ["brushed aluminum", "composite panels", "insulated conduits", "frosted seals"],
    "lighting": ["amber strips", "instrument glow", "low ceiling fixtures"],
    "motifs": [
      {"id": "procedural_signage", "text": "procedural signage, checklist placards, compliance labels, stamped tags"},
      {"id": "frost_and_condensation", "text": "frosted seams, breath condensation, chilled airlocks"},
      {"id": "tight_corridors", "text": "cramped corridors, cable trays, low ceilings, utilitarian geometry"}
