{
  "schema_version": "worldcodex.world_bible.v1",
  "world": {
    "id": "argonaut_station",
    "name": "Argonaut Station",
    "logline": "A cramped Titan colony where bureaucracy and life-support rituals keep people alive and quietly afraid.",
    "genre_tags": ["hard_sf", "bureaucratic_dread"],
    "timeframe": "late-22nd-century",
    "technology_level": "advanced-industrial",
    "tone": {
      "keywords": ["procedural", "contained", "industrial", "quiet-dread"],
      "do": ["orderly composition", "subtle tension"],
      "avoid": ["utopian gloss", "cartoon tech"]
    }
  },
  "visual_identity": {
    "palette": [
      {"name": "amber_maintenance", "keywords": ["amber maintenance lighting", "warm sodium glow", "warning-amber accents"]}
